{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.glassrpg.com"
        }
      ],
      "destination": "https://glassrpg.com/:path*",
      "permanent": true
    },
    {
      "source": "/NoCodeXport(.*)",
      "destination": "/",
      "permanent": true
    }
  ]
}
